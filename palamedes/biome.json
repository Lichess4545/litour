{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": "off",
        "noExplicitAny": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/env.ts",
        "src/env.test.ts",
        "src/chess/encounters.ts",
        "src/server/http/app.test.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    {
      "includes": ["src/server/http/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import z from \"@hono/zod-openapi\" instead — it runs extendZodWithOpenApi(z) as a side effect, and importing plain \"zod\" here typechecks but throws \"openapi is not a function\" at runtime unless that side effect ran first.",
                  "@/server/lichess/introspection": {
                    "importNames": ["createTokenVerifier"],
                    "message": "createTokenVerifier holds per-process state (negative cache, in-flight map, circuit breaker) that must exist exactly once. Import the pinned singleton verifyLichessToken from \"@/server/lichess/verifier\" instead of constructing your own verifier."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/http/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import z from \"@hono/zod-openapi\" instead — it runs extendZodWithOpenApi(z) as a side effect, and importing plain \"zod\" here typechecks but throws \"openapi is not a function\" at runtime unless that side effect ran first."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**",
        "!src/server/http/**",
        "!src/server/lichess/verifier.ts",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/server/lichess/introspection": {
                    "importNames": ["createTokenVerifier"],
                    "message": "createTokenVerifier holds per-process state (negative cache, in-flight map, circuit breaker) that must exist exactly once. Import the pinned singleton verifyLichessToken from \"@/server/lichess/verifier\" instead of constructing your own verifier."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth core models (matches `bunx @better-auth/cli generate` output)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  posts         Post[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([authorId])
  @@map("post")
}

model DefinitionChange {
  seq        Int      @id @default(autoincrement())
  streamId   String
  version    Int
  type       String
  payload    Json
  // NOTE: @default is backfill for pre-hardening rows only — the DAL always stamps both explicitly; see design/adr/0010-registry-identity-and-schema-evolution.md
  schemaRev  Int      @default(1)
  registryId String   @default("chess/1")
  actorId    String?
  recordedAt DateTime @default(now())

  // NOTE: OCC conflict guard — a duplicate (streamId, version) raises P2002 and aborts the entire createMany; see design/adr/0003-optimistic-concurrency-via-unique-constraint.md
  @@unique([streamId, version])
  @@map("definition_change")
}

model DefinitionStream {
  streamId  String   @id
  ownerId   String?
  // NOTE: @default is backfill for rows written before the DAL stamped this
  // explicitly — the write path (seed.ts's upsert) always passes createdAt itself.
  createdAt DateTime @default(now())

  @@map("definition_stream")
}

model LichessToken {
  // NOTE: sha256 hex of the raw token, never the token itself — see
  // src/server/lichess/introspection.ts.
  tokenHash  String    @id
  userId     String
  scopes     String
  expiresAt  DateTime?
  verifiedAt DateTime

  @@map("lichess_token")
}
